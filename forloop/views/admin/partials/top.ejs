<%- include('../../shared/head', { bodyClass: 'admin' }) %>
<button class="btn round menu-toggle" aria-label="Toggle navigation" aria-expanded="false"><%- icon('grid', 20) %></button>
<div class="shell">
  <aside class="side">
    <%- include('../../shared/logo', { light: true }) %>
    <form class="search side-search" action="/admin/members" method="get"><%- icon('search', 20) %><input name="q" placeholder="Search members…" autocomplete="off"><kbd data-shortcut>Ctrl K</kbd></form>
    <p class="side-label">Organization</p>
    <nav>
      <% [['overview','/admin','grid','Overview'],['organization','/admin/organization','building','Organization'],['members','/admin/members','userplus','Members'],['officers','/admin/officers','chart','Officers'],['applications','/admin/applications','file','Applications'],['events','/admin/events','calendar','Events'],['announcements','/admin/announcements','spark','Announcements'],['reports','/admin/reports','chart','Reports']].forEach(function (n) { %>
        <a href="<%= n[1] %>" class="<%= locals.active === n[0] ? 'on' : '' %>"><%- icon(n[2], 22) %><span><%= n[3] %></span><% if (n[0] === 'applications' && badge > 0) { %><em class="count"><%= badge %></em><% } %></a>
      <% }) %>
    </nav>
    <div class="side-bottom">
      <div class="dd">
        <button type="button" class="side-btn" data-dd="notesMenu" aria-label="Notifications"><%- icon('bell', 22) %><span>Notifications</span><% if (unread > 0) { %><i class="dot" id="bellDot"></i><% } %></button>
        <div class="dd-menu notes" id="notesMenu" hidden>
          <div class="dd-title">Notifications</div>
          <% if (!notes.length) { %><p class="empty">Nothing yet. New updates will show up here.</p><% } %>
          <% notes.forEach(function (n) { %>
            <div class="note <%= n.is_read ? '' : 'new' %>"><p><%= n.message %></p><small><%= fmtShort(n.created_at) %></small></div>
          <% }) %>
        </div>
      </div>
      <button type="button" class="side-btn theme-btn" data-theme-toggle aria-label="Toggle dark mode"><%- icon('sun', 22, 'th-sun') %><%- icon('moon', 22, 'th-moon') %><span>Dark mode</span></button>
      <a href="/settings" class="<%= locals.active === 'settings' ? 'on' : '' %>"><%- icon('settings', 22) %><span>Settings</span></a>
      <a href="/logout"><%- icon('logout', 22) %><span>Log out</span></a>
      <a href="/profile" class="me" title="View profile">
        <span class="avatar"><%- avatarInner(me.avatar, me.name) %><i class="online"></i></span>
        <div><strong><%= me.name %></strong><small><%= org.name %> adviser</small></div>
      </a>
    </div>
  </aside>
  <div class="stage">
    <main class="content">
