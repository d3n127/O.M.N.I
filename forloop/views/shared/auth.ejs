<% var isRegister = mode === 'register'; %>
<% var isAdviser = role === 'adviser'; %>
<%- include('head', { title: isRegister ? 'Create your account' : 'Sign in', bodyClass: 'auth ' + (isRegister && isAdviser ? 't-admin' : 't-student') }) %>
<div class="auth-decor" aria-hidden="true"><div class="sun-wrap"><i class="orbit o2"></i><i class="orbit o1"></i><i class="halo"></i><i class="sun"></i></div></div>

<!-- Site header -->
<header class="auth-nav">
  <div class="auth-nav-in">
    <%- include('logo') %>
    <div class="auth-nav-act">
      <button class="round theme-btn" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
        <span class="th-ic"><%- icon('sun', 18, 'th-sun') %><%- icon('moon', 18, 'th-moon') %></span>
      </button>
      <a class="btn small" href="<%= isRegister ? '/login' : '/register' %>"><%= isRegister ? 'Sign in' : 'Get started' %></a>
    </div>
  </div>
</header>

<section class="auth-card" data-mode="<%= mode %>" id="authCard">
  <p class="eyebrow">Student organization portal</p>
  <h1 id="authTitle"><%= isRegister ? 'Create your space.' : 'Welcome back.' %></h1>
  <p class="sub" id="authSub"><%= isRegister ? 'Join the community and start making an impact.' : 'Sign in to continue your campus journey.' %></p>

  <div class="tabs" role="tablist">
    <button type="button" data-tab="login" class="<%= isRegister ? '' : 'on' %>" role="tab">Sign in</button>
    <button type="button" data-tab="register" class="<%= isRegister ? 'on' : '' %>" role="tab">Create account</button>
  </div>

  <% if (error) { %><p class="form-error show"><%= error %></p><% } %>

  <!-- Sign in -->
  <form method="post" action="/auth/login" id="loginForm" <%= isRegister ? 'hidden' : '' %>>
    <label for="l_email">University email</label>
    <input id="l_email" type="email" name="email" placeholder="you@university.edu" required value="<%= values.email || '' %>" autocomplete="email">
    <label for="l_pw">Password</label>
    <input id="l_pw" type="password" name="password" placeholder="Your password" required autocomplete="current-password">
    <button class="btn block" type="submit">Sign in <%- icon('arrow', 18) %></button>
    <p class="hint">Demo — <%= demo %></p>
  </form>

  <!-- Sign up -->
  <form method="post" action="/auth/register" id="registerForm" <%= isRegister ? '' : 'hidden' %>>
    <label for="r_name">Full name</label>
    <input id="r_name" name="full_name" placeholder="Your full name" required value="<%= values.full_name || '' %>" autocomplete="name">
    <label for="r_email">University email</label>
    <input id="r_email" type="email" name="email" placeholder="you@university.edu" required value="<%= values.email || '' %>" autocomplete="email">
    <label for="r_pw">Password</label>
    <input id="r_pw" type="password" name="password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">

    <label id="roleLabel">I am a…</label>
    <div class="role-pick" role="radiogroup" aria-labelledby="roleLabel">
      <label class="role-opt <%= isAdviser ? '' : 'on' %>" for="r_student">
        <input type="radio" id="r_student" name="role" value="student" <%= isAdviser ? '' : 'checked' %>>
        <span class="role-ic"><%- icon('userplus', 20) %></span>
        <span class="role-tx"><strong>Student</strong><small>Discover, apply and join organizations</small></span>
      </label>
      <label class="role-opt <%= isAdviser ? 'on' : '' %>" for="r_adviser">
        <input type="radio" id="r_adviser" name="role" value="adviser" <%= isAdviser ? 'checked' : '' %>>
        <span class="role-ic"><%- icon('building', 20) %></span>
        <span class="role-tx"><strong>Adviser</strong><small>Run an organization of your own</small></span>
      </label>
    </div>

    <div id="orgField" <%= isAdviser ? '' : 'hidden' %>>
      <label for="r_org">Organization name</label>
      <input id="r_org" name="org_name" placeholder="e.g. UIPC" value="<%= values.org_name || '' %>" <%= isAdviser ? 'required' : '' %>>
    </div>

    <button class="btn block" type="submit">Create account <%- icon('arrow', 18) %></button>
    <p class="hint" id="regHint"><%= isAdviser ? 'Your organization is created with your account.' : "Right after signing up you'll set up your required student information." %></p>
  </form>
</section>
<%- include('foot') %>
