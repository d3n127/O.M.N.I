<% var shell = locals.portal || 'student'; %>
<%- include('../' + shell + '/partials/top') %>
<p class="eyebrow">Account</p>
<h1 class="page-title">Settings</h1>
<p class="lead">Manage your personal details, security and appearance. <a class="underline" href="/profile">View profile</a></p>

<div class="card pf-card pf-photo">
  <span class="avatar big" id="avatarPreview"><%- avatarInner(me.avatar, u.full_name) %></span>
  <div>
    <h2>Profile picture</h2>
    <p class="muted">JPG, PNG or WebP, up to 2 MB.</p>
    <label class="btn upload-btn">Upload photo
      <input type="file" accept="image/jpeg,image/png,image/webp" data-upload="/upload/avatar" data-preview="#avatarPreview" hidden>
    </label>
  </div>
</div>

<div class="pf-grid">
  <form class="card pf-card" method="post" action="/profile">
    <h2>Edit profile</h2>
    <label for="p_name">Full name</label>
    <input id="p_name" name="full_name" value="<%= u.full_name %>" required>
    <label for="p_email">University email</label>
    <input id="p_email" type="email" name="email" value="<%= u.email %>" required>
    <% if (u.role === 'student') { %>
      <label for="p_sid">Student ID</label>
      <input id="p_sid" name="student_id" value="<%= u.student_id || '' %>" placeholder="e.g. 2024-12345" required maxlength="24">
      <label for="p_program">Program (course)</label>
      <select id="p_program" name="program" required>
        <% var ppv = u.program || ''; if (ppv && programs.indexOf(ppv) === -1) { %>
          <option value="<%= ppv %>" selected><%= ppv %></option>
        <% } %>
        <% programs.forEach(function (p) { %>
          <option value="<%= p %>" <%= ppv === p ? 'selected' : '' %>><%= p %></option>
        <% }) %>
      </select>
      <label for="p_year">Year level</label>
      <select id="p_year" name="year_level">
        <% [1, 2, 3, 4].forEach(function (y) { %>
          <option value="<%= y %>" <%= Number(u.year_level) === y ? 'selected' : '' %>>Year <%= y %></option>
        <% }) %>
      </select>
      <label for="p_contact">Contact number</label>
      <input id="p_contact" name="contact" type="tel" value="<%= u.contact || '' %>" required maxlength="30">
      <label for="p_college">Department (college / faculty)</label>
      <select id="p_college" name="college" required>
        <% var pcv = u.college || ''; if (pcv && departments.indexOf(pcv) === -1) { %>
          <option value="<%= pcv %>" selected><%= pcv %></option>
        <% } %>
        <% departments.forEach(function (d) { %>
          <option value="<%= d %>" <%= pcv === d ? 'selected' : '' %>><%= d %> (<%= deptAbbr(d) %>)</option>
        <% }) %>
      </select>
      <label for="p_bio">Short bio <small>(up to 300 characters)</small></label>
      <textarea id="p_bio" name="bio" rows="3" maxlength="300"><%= u.bio || '' %></textarea>
      <label for="p_hobbies">Hobbies <small>(optional, comma separated)</small></label>
      <input id="p_hobbies" name="hobbies" maxlength="300" placeholder="Chess, Basketball, Painting" value="<%= u.hobbies || '' %>">
    <% } %>
    <button class="btn" type="submit">Save changes <%- icon('arrow', 18) %></button>
  </form>

  <form class="card pf-card" method="post" action="/profile/password">
    <h2>Change password</h2>
    <label for="p_cur">Current password</label>
    <input id="p_cur" type="password" name="current_password" required autocomplete="current-password">
    <label for="p_new">New password <small>(at least 6 characters)</small></label>
    <input id="p_new" type="password" name="new_password" minlength="6" required autocomplete="new-password">
    <label for="p_confirm">Confirm new password</label>
    <input id="p_confirm" type="password" name="confirm_password" minlength="6" required autocomplete="new-password">
    <button class="btn" type="submit">Update password <%- icon('arrow', 18) %></button>
  </form>
</div>

<div class="card pf-card pf-theme">
  <h2>Appearance</h2>
  <p class="muted">Choose how O.M.N.I looks on this device.</p>
  <div class="theme-switch">
    <button type="button" class="theme-set" data-theme-set="light"><%- icon('sun', 16) %> Light</button>
    <button type="button" class="theme-set" data-theme-set="dark"><%- icon('moon', 16) %> Dark</button>
  </div>
</div>
<%- include('../' + shell + '/partials/bottom') %>
