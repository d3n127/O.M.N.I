<%- include('partials/top') %>
<p class="eyebrow">Your communities</p>
<h1 class="page-title">My Organization</h1>
<p class="lead">The groups you belong to and everything happening inside them.</p>

<% if (!mine.length) { %>
  <div class="card empty-card"><h3>You haven’t joined an organization yet.</h3><p>Once an application is approved, your organization shows up here. <a class="underline" href="/student/discover">Browse organizations</a>.</p></div>
<% } %>
<% mine.forEach(function (o) { %>
  <section class="mine c-<%= o.color %>">
    <span class="logo-badge big lb-<%= o.logo_style %>"><% if (o.logo_img.charAt(0) === '/') { %><img src="<%= o.logo_img %>" alt="" /><% } else { %><%= o.logo_img %><% } %></span>
    <div>
      <p class="eyebrow">Active member · <%= o.role_title %></p>
      <h2><%= o.name %></h2>
      <p>You joined on <%= fmtLong(o.joined_at) %> · <%= o.upcoming %> upcoming <%= o.upcoming == 1 ? 'activity' : 'activities' %></p>
    </div>
    <div class="mine-actions">
      <a class="btn dark" href="/student/events?org=<%= o.id %>">View activities <%- icon('arrow', 18) %></a>
      <a class="btn outline" href="/student/organizations/<%= o.id %>/directory"><%- icon('userplus', 18) %> Directory</a>
    </div>
  </section>
<% }) %>

<% if (mine.length) { %>
  <div class="block-head ev-section">
    <div><p class="eyebrow">From your organizations</p><h2>Announcements</h2></div>
    <a class="more" href="/student/announcements">See all <%- icon('arrow', 18) %></a>
  </div>
  <% if (!announcements.length) { %>
    <div class="card empty-card"><h3>Nothing yet.</h3><p>When your organizations post an update, it will show up here.</p></div>
  <% } %>
  <div class="news-grid wide">
    <% announcements.forEach(function (a) { %>
      <article class="news c-<%= a.color %>">
        <p class="eyebrow"><%= a.org_name %> · <%= fmtShort(a.created_at) %></p>
        <h3><%= a.title %></h3>
        <% if (a.body) { %><p><%= a.body %></p><% } %>
      </article>
    <% }) %>
  </div>
<% } %>
<%- include('partials/bottom') %>
