<article class="org" data-category="<%= o.category %>" data-eligibility="<%= o.eligibility || 'International' %>">
  <% var hasLogo = o.logo_img.charAt(0) === '/'; %>
  <div class="org-top c-<%= o.color %> <%= hasLogo ? 'has-img' : '' %>">
    <% if (hasLogo) { %><img class="org-cover back" src="<%= o.logo_img %>" alt=""><img class="org-cover" src="<%= o.logo_img %>" alt=""><% } %>
    <button class="save <%= o.saved ? 'on' : '' %>" data-save="<%= o.id %>" aria-label="Save <%= o.name %>"><%- icon('bookmark', 18) %></button>
    <% if (!hasLogo) { %><span class="logo-badge lb-<%= o.logo_style %>"><%= o.logo_img %></span><% } %>
    <span class="pill"><%- icon('userplus', 14) %><%= o.member_count %> member<%= o.member_count == 1 ? '' : 's' %></span>
  </div>
  <div class="org-body">
    <div class="tags">
      <span class="elig"><%- icon('globe', 12) %><%= o.eligibility === 'International' || !o.eligibility ? 'International' : deptAbbr(o.eligibility) + ' only' %></span>
      <% String(o.tags).split(',').forEach(function (t) { if (t.trim()) { %><span><%= t.trim() %></span><% } }) %>
    </div>
    <h3><%= o.name %></h3>
    <p><%= o.description %></p>
    <button class="org-cta" data-apply
      data-id="<%= o.id %>" data-name="<%= o.name %>" data-desc="<%= o.description %>"
      data-category="<%= o.category %>" data-schedule="<%= o.meeting_schedule %>"
      data-members="<%= o.member_count %>" data-status="<%= o.is_member ? 'member' : (o.app_status || '') %>">
      View &amp; apply <%- icon('arrow', 18) %>
    </button>
  </div>
</article>
