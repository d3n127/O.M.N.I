<%- include('../../shared/head') %>
<header class="topbar">
  <%- include('../../shared/logo') %>
  <nav class="topnav">
    <% [['home','/student','grid','Home'],['discover','/student/discover','compass','Discover'],['applications','/student/applications','file','Applications'],['events','/student/events','calendar','Events'],['recruitment','/student/recruitment','spark','Recruitment'],['orgs','/student/organizations','userplus','My Organization']].forEach(function (n) { %>
      <a href="<%= n[1] %>" class="<%= locals.active === n[0] ? 'on' : '' %>"><%- icon(n[2], 18) %><%= n[3] %><% if (n[0] === 'applications' && badge > 0) { %><span class="count"><%= badge %></span><% } %></a>
    <% }) %>
  </nav>
  <div class="tools">
    <form class="search" action="/student/discover" method="get"><%- icon('search', 18) %><input name="q" placeholder="Search…" value="<%= locals.q || '' %>" autocomplete="off"><kbd>⌘ K</kbd></form>
    <%- include('../../shared/tools') %>
  </div>
</header>
<main class="wrap">
