<%- include('partials/top') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Your community</p>
    <h1 class="page-title">Members</h1>
    <p class="lead"><%= q ? members.length + ' result' + (members.length == 1 ? '' : 's') + ' for “' + q + '”. ' : '' %>Connect with your people and keep your roster organized.</p>
  </div>
  <button class="btn" data-open="inviteModal"><%- icon('plus', 18) %> Invite member</button>
</div>

<div class="table card flush">
  <div class="tr th"><span>Member</span><span>Role</span><span>Joined</span><span>Actions</span></div>
  <% if (!members.length) { %><p class="empty pad">No members found.</p><% } %>
  <% members.forEach(function (m) { %>
    <div class="tr">
      <span class="who"><i class="av"><%= initials(m.full_name) %></i><strong><%= m.full_name %></strong></span>
      <span><%= m.role_title %></span>
      <span><%= fmtMonthYear(m.joined_at) %></span>
      <span class="act">
        <details class="menu">
          <summary aria-label="Member actions"><%- icon('dots', 20) %></summary>
          <div class="menu-box">
            <% roles.forEach(function (r) { if (r !== m.role_title) { %>
              <form method="post" action="/admin/members/<%= m.mid %>/role"><input type="hidden" name="role" value="<%= r %>"><button>Make <%= r %></button></form>
            <% } }) %>
            <form method="post" action="/admin/members/<%= m.mid %>/remove" data-confirm="Remove <%= m.full_name %> from <%= org.name %>?"><button class="danger">Remove member</button></form>
          </div>
        </details>
      </span>
    </div>
  <% }) %>
</div>

<div class="modal" id="inviteModal" hidden>
  <div class="modal-box slim" role="dialog" aria-modal="true">
    <button class="close" data-close aria-label="Close"><%- icon('x', 18) %></button>
    <p class="eyebrow">Invite member</p>
    <h2>Add a student</h2>
    <p class="sub">Enter the university email of a student who already has an account.</p>
    <form method="post" action="/admin/members/invite" class="form">
      <label for="inv_email">University email</label>
      <input id="inv_email" type="email" name="email" placeholder="student@north.edu" required>
      <button class="btn block" type="submit">Add to <%= org.name %> <%- icon('arrow', 18) %></button>
    </form>
  </div>
</div>
<%- include('partials/bottom') %>
