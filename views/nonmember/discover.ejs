<%- include('partials/top') %>
<p class="eyebrow">Explore campus</p>
<h1 class="page-title">Discover organizations</h1>
<p class="lead"><%= q ? 'Results for “' + q + '”. ' : '' %>Find a community built around what you care about.</p>

<div class="chips" data-filter>
  <button class="on" data-cat="all">All</button>
  <% cats.forEach(function (c) { %><button data-cat="<%= c %>"><%= c %></button><% }) %>
</div>

<% if (!orgs.length) { %>
  <div class="card empty-card"><h3>No organizations match “<%= q %>”.</h3><p>Try a different word, or <a class="underline" href="/nonmember/discover">see everything</a>.</p></div>
<% } %>
<div class="org-grid">
  <% orgs.forEach(function (o) { %><%- include('../student/partials/orgcard', { o: o }) %><% }) %>
</div>

<%- include('../student/partials/apply_modal', { applyEndpoint: '/nonmember/apply' }) %>
<%- include('partials/bottom') %>
