<% const isAdmin = role === 'admin'; %>
<%- include('head', { title: isAdmin ? 'Organization portal' : 'Student portal', bodyClass: 'auth ' + (isAdmin ? 't-admin' : 't-student') }) %>
<div class="sun-wrap" aria-hidden="true"><i class="orbit o2"></i><i class="orbit o1"></i><i class="halo"></i><i class="sun"></i></div>
<section class="auth-card" data-mode="<%= mode %>" id="authCard">
  <a class="back" href="/">← Back to roles</a>
  <%- include('logo') %>
  <p class="eyebrow"><%= isAdmin ? 'Organization portal' : 'Student portal' %></p>
  <h1 id="authTitle"><%= mode === 'register' ? 'Create your space.' : 'Welcome back.' %></h1>
  <p class="sub" id="authSub"><%= mode === 'register' ? 'Join the community and start making an impact.' : 'Sign in to continue your campus journey.' %></p>

  <div class="tabs" role="tablist">
    <button type="button" data-tab="login" class="<%= mode === 'login' ? 'on' : '' %>" role="tab">Sign in</button>
    <button type="button" data-tab="register" class="<%= mode === 'register' ? 'on' : '' %>" role="tab">Create account</button>
  </div>

  <% if (error) { %><p class="form-error show"><%= error %></p><% } %>

  <form method="post" action="/auth/login" id="loginForm" <%= mode === 'register' ? 'hidden' : '' %>>
    <input type="hidden" name="role" value="<%= role %>">
    <label for="l_email">University email</label>
    <input id="l_email" type="email" name="email" placeholder="you@university.edu" required value="<%= values.email || '' %>" autocomplete="email">
    <label for="l_pw">Password</label>
    <input id="l_pw" type="password" name="password" placeholder="Your password" required value="<%= values.email ? '' : '' %>" autocomplete="">
    <br>
    <button class="btn block" type="submit">Sign in <%- icon('arrow', 18) %></button>
    <p class="hint">Demo ready — use the prefilled details to explore.</p>
  </form>

  <form method="post" action="/auth/register" id="registerForm" <%= mode === 'login' ? 'hidden' : '' %>>
    <input type="hidden" name="role" value="<%= role %>">
    <label for="r_name">Full name</label>
    <input id="r_name" name="full_name" placeholder="Your full name" required value="<%= values.full_name || '' %>" autocomplete="name">
    <label for="r_email">University email</label>
    <input id="r_email" type="email" name="email" placeholder="you@university.edu" required value="<%= values.email || '' %>" autocomplete="email">
    <br>
    <label for="r_pw">Password</label>
    
    <input id="r_pw" type="password" name="password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
    <% if (isAdmin) { %>
      <label for="r_org">Organization name</label>
      <input id="r_org" name="org_name" placeholder="e.g. UIPC" required value="<%= values.org_name || '' %>">
    <% } %>
    <button class="btn block" type="submit">Create account <%- icon('arrow', 18) %></button>
  </form>
</section>
<%- include('foot') %>
