<% var shell = locals.portal || 'student'; %>
<%- include('../' + shell + '/partials/top') %>
<p class="eyebrow">Account</p>
<h1 class="page-title">Profile</h1>
<p class="lead">Your campus identity — how other students see you.</p>

<div class="pf-hero card">
  <span class="avatar big"><%= initials(u.full_name) %></span>
  <div class="pf-id">
    <h2><%= u.full_name %></h2>
    <p class="muted"><%= u.email %></p>
    <div class="pf-chips">
      <% if (u.role === 'admin') { %>
        <span class="pf-chip">Organization officer<%= orgName ? ' · ' + orgName : '' %></span>
      <% } else { %>
        <span class="pf-chip">Student · ID <%= u.student_id || '—' %> · <%= u.program %> · Year <%= u.year_level %></span>
        <span class="pf-chip"><%= deptAbbr(u.college) %></span>
      <% } %>
      <% (orgs || []).forEach(function (o) { %>
        <span class="pf-chip"><%= o.name %> · <%= o.role_title %></span>
      <% }) %>
      <span class="pf-chip">Member since <%= fmtMonthYear(u.created_at) %></span>
    </div>
  </div>
  <a class="btn pf-edit" href="/settings">Edit profile <%- icon('arrow', 18) %></a>
</div>

<% if (u.role === 'student') { %>
  <div class="card pf-card pf-detail">
    <h2>Student information</h2>
    <div class="pf-row"><span class="muted">Student ID</span><strong><%= u.student_id || '—' %></strong></div>
    <div class="pf-row"><span class="muted">Program</span><strong><%= u.program %></strong></div>
    <div class="pf-row"><span class="muted">Year level</span><strong>Year <%= u.year_level %></strong></div>
    <div class="pf-row"><span class="muted">Department</span><strong><%= u.college %> (<%= deptAbbr(u.college) %>)</strong></div>
    <div class="pf-row"><span class="muted">Contact</span><strong><%= u.contact || '—' %></strong></div>
    <div class="pf-row"><span class="muted">Bio</span><strong class="pf-bio"><%= u.bio || '—' %></strong></div>
    <div class="pf-row">
      <span class="muted">Hobbies</span>
      <span class="pf-chips">
        <% var hobbies = String(u.hobbies || '').split(',').map(function (h) { return h.trim(); }).filter(Boolean); %>
        <% if (hobbies.length) { hobbies.forEach(function (h) { %><span class="pf-chip"><%= h %></span><% }) %>
        <% } else { %><strong>—</strong><% } %>
      </span>
    </div>
  </div>

  <% if (orgs.length) { %>
    <div class="card pf-card pf-detail">
      <h2>My organizations</h2>
      <% orgs.forEach(function (o) { %>
        <div class="pf-row"><span class="muted"><%= o.name %></span><strong><%= o.role_title %> · joined <%= fmtMonthYear(o.joined_at) %></strong></div>
      <% }) %>
    </div>
  <% } %>
<% } else { %>
  <div class="card pf-card pf-detail">
    <h2>Organization</h2>
    <div class="pf-row"><span class="muted">Organization</span><strong><%= orgName || '—' %></strong></div>
    <div class="pf-row"><span class="muted">Role</span><strong>Organization officer</strong></div>
    <div class="pf-row"><span class="muted">Member since</span><strong><%= fmtMonthYear(u.created_at) %></strong></div>
  </div>
<% } %>
<%- include('../' + shell + '/partials/bottom') %>
