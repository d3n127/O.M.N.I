<div class="dd">
  <button class="icon-btn" data-dd="notesMenu" aria-label="Notifications"><%- icon('bell', 20) %><% if (unread > 0) { %><i class="dot" id="bellDot"></i><% } %></button>
  <div class="dd-menu notes" id="notesMenu" hidden>
    <div class="dd-title">Notifications</div>
    <% if (!notes.length) { %><p class="empty">Nothing yet. New updates will show up here.</p><% } %>
    <% notes.forEach(function (n) { %>
      <div class="note <%= n.is_read ? '' : 'new' %>"><p><%= n.message %></p><small><%= fmtShort(n.created_at) %></small></div>
    <% }) %>
  </div>
</div>
<button class="icon-btn theme-btn" data-theme-toggle aria-label="Toggle dark mode"><%- icon('sun', 18, 'th-sun') %><%- icon('moon', 18, 'th-moon') %></button>
<div class="dd">
  <button class="avatar" data-dd="userMenu" aria-label="Account menu"><%= initials(me.name) %></button>
  <div class="dd-menu" id="userMenu" hidden>
    <div class="dd-title"><%= me.name %></div>
    <a href="/profile">Profile</a>
    <a href="/settings">Settings</a>
    <a href="/logout">Log out</a>
  </div>
</div>
