<%- include('partials/top') %>
<p class="eyebrow">Campus calendar</p>
<h1 class="page-title">Events &amp; activities</h1>
<p class="lead">
  <% if (filterOrg) { %>Showing activities from <%= filterOrg %>. <a class="underline" href="/student/events">Show all</a>
  <% } else { %>Show up, try something new, and meet your next favorite people.<% } %>
</p>

<% if (!events.length) { %>
  <div class="card empty-card"><h3>No upcoming events.</h3><p>When an organization publishes one, it will appear here.</p></div>
<% } %>
<div class="ev-grid">
  <% var tiles = ['yellow','teal','lime','lilac']; events.forEach(function (e, i) { %>
    <article class="ev-card">
      <div class="ev-top c-<%= tiles[i % 4] %>">
        <span class="num"><%= String(i + 1).padStart(2, '0') %></span>
        <span class="when"><%= fmtMon(e.event_date) %> <%= fmtDay(e.event_date) %></span>
      </div>
      <div class="ev-body">
        <p class="eyebrow"><%= e.org_name %></p>
        <h3><%= e.title %></h3>
        <p class="meta"><%- icon('clock', 15) %> <%= fmtTime(e.event_time) %> · <%= e.location %></p>
        <% if (e.description) { %><p class="desc"><%= e.description %></p><% } %>
        <form method="post" action="/student/events/<%= e.id %>/rsvp">
          <% if (e.joined) { %>
            <button class="btn outline block joined" type="submit"><%- icon('check', 18) %> You’re going · Cancel</button>
          <% } else { %>
            <button class="btn outline block" type="submit">Join event <%- icon('arrow', 18) %></button>
          <% } %>
        </form>
      </div>
    </article>
  <% }) %>
</div>
<%- include('partials/bottom') %>
