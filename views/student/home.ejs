<%- include('partials/top') %>

<section class="hero">
  <i class="h-sun"></i><i class="h-arc"></i><i class="h-line l1"></i><i class="h-line l2"></i>
  <span class="spark s1">✦</span><span class="spark s2">✦</span>
  <p class="eyebrow">Welcome to O.M.N.I</p>
  <h1>Your campus.<br>Your community.</h1>
  <p>Discover the organizations, people, and experiences that make campus feel like home.</p>
</section>

<section class="stats">
  <a class="stat" href="/student/applications"><span class="s-ic yellow"><%- icon('file', 22) %></span><div><strong><%= stats.active %></strong><small>Active applications</small></div><em>View <%- icon('arrow', 16) %></em></a>
  <a class="stat" href="/student/organizations"><span class="s-ic lime"><%- icon('check', 22) %></span><div><strong><%= stats.joined %></strong><small>Organization<%= stats.joined == 1 ? '' : 's' %> joined</small></div><em>View <%- icon('arrow', 16) %></em></a>
  <a class="stat" href="/student/events"><span class="s-ic teal"><%- icon('calendar', 22) %></span><div><strong><%= stats.upcoming %></strong><small>Upcoming events</small></div><em>View <%- icon('arrow', 16) %></em></a>
</section>

<section class="section-block">
  <div class="block-head">
    <div><p class="eyebrow">Find your community</p><h2>Organizations for you</h2></div>
    <a class="more" href="/student/discover">Browse all <%- icon('arrow', 18) %></a>
  </div>
  <div class="chips" data-filter>
    <button class="on" data-cat="all">All</button>
    <% cats.forEach(function (c) { %><button data-cat="<%= c %>"><%= c %></button><% }) %>
  </div>
  <div class="org-grid">
    <% orgs.forEach(function (o) { %><%- include('partials/orgcard', { o: o }) %><% }) %>
  </div>
</section>

<section class="two">
  <div class="card">
    <p class="eyebrow">Save the date</p>
    <div class="block-head tight"><h2>Coming up</h2><a class="underline" href="/student/events">View calendar</a></div>
    <% if (!events.length) { %><p class="empty">No events yet. Check back soon.</p><% } %>
    <% var tiles = ['yellow','teal','lime']; events.forEach(function (e, i) { %>
      <a class="ev-row" href="/student/events">
        <span class="date-tile <%= tiles[i % 3] %>"><small><%= fmtMon(e.event_date) %></small><b><%= fmtDay(e.event_date) %></b></span>
        <div><strong><%= e.title %></strong><small><%= e.org_name %> <span class="sep"></span><%- icon('clock', 14) %> <%= fmtTime(e.event_time) %></small></div>
        <span class="round"><%- icon('arrow', 18) %></span>
      </a>
    <% }) %>
  </div>

  <div class="card tan">
    <p class="eyebrow">Your progress</p>
    <h2>Applications</h2>
    <% if (!apps.length) { %><p class="empty">You haven’t applied anywhere yet. Pick an organization above to start.</p><% } %>
    <% apps.forEach(function (a) { %>
      <div class="prog">
        <div class="prog-top">
          <span class="mini c-<%= a.color %>"><%= a.logo_text %></span>
          <div><strong><%= a.org_name %></strong><small>Submitted <%= fmtShort(a.created_at) %></small></div>
          <span class="badge <%= a.status %>"><%= a.status === 'pending' ? 'In review' : a.status === 'approved' ? 'Accepted' : 'Declined' %></span>
        </div>
        <div class="bar"><i style="width: <%= a.status === 'pending' ? 50 : 100 %>%"></i></div>
        <div class="bar-labels"><span>Sent</span><span>Review</span><span>Decision</span></div>
      </div>
    <% }) %>
    <a class="btn outline block" href="/student/applications">Manage applications <%- icon('arrow', 18) %></a>
  </div>
</section>

<%- include('partials/apply_modal') %>
<%- include('partials/bottom') %>
