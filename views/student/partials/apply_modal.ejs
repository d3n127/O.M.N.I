<div class="modal" id="applyModal" hidden>
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="applyTitle">
    <button class="close" data-close aria-label="Close"><%- icon('x', 18) %></button>

    <div id="applyStep">
      <p class="eyebrow">Quick application</p>
      <h2 id="applyTitle">Join</h2>
      <p class="sub" id="applySub">Tell the team why this community feels like the right fit for you.</p>
      <div class="facts" id="applyFacts"></div>
      <div class="notice" id="applyNotice" hidden></div>
      <form id="applyForm" novalidate data-endpoint="<%= locals.applyEndpoint || '/student/apply' %>">
        <input type="hidden" name="org_id" id="applyOrg">
        <label for="applyIntro">Your short introduction</label>
        <textarea id="applyIntro" name="intro" rows="4" placeholder="Share your interests, experience, or what you hope to learn…"></textarea>
        <label class="check"><input type="checkbox" name="agree" id="applyAgree"> I agree to share my student profile.</label>
        <p class="form-error" id="applyError" hidden></p>
        <button class="btn block" type="submit">Submit application <%- icon('arrow', 18) %></button>
      </form>
    </div>

    <div id="applyDone" class="done" hidden>
      <span class="big-check"><%- icon('check', 34) %></span>
      <p class="eyebrow">Application sent</p>
      <h2>You’re all set.</h2>
      <p class="sub" id="applyDoneText"></p>
      <button class="btn block" type="button" data-reload>Back to organizations</button>
    </div>
  </div>
</div>
