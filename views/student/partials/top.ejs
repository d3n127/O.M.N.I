<%- include('../../shared/head') %>
<header class="topbar">
  <%- include('../../shared/logo') %>
  <nav class="topnav" aria-label="Main">
    <% [['home','/student','grid','Home','Home'],['discover','/student/discover','compass','Discover','Discover'],['applications','/student/applications','file','Applications','Apps'],['events','/student/events','calendar','Events','Events'],['orgs','/student/organizations','userplus','My organizations','Orgs']].forEach(function (n) { %>
      <a href="<%= n[1] %>" class="<%= locals.active === n[0] ? 'on' : '' %>" <%- locals.active === n[0] ? 'aria-current="page"' : '' %>><%- icon(n[2], 18) %><span class="nav-label"><%= n[3] %></span><span class="nav-short"><%= n[4] %></span><% if (n[0] === 'applications' && badge > 0) { %><span class="count"><%= badge %></span><% } %></a>
    <% }) %>
  </nav>
  <form class="search top-search" action="/student/discover" method="get"><%- icon('search', 18) %><input name="q" placeholder="Search organizations…" value="<%= locals.q || '' %>" autocomplete="off"><kbd>⌘ K</kbd></form>
  <div class="tools">
    <%- include('../../shared/tools') %>
  </div>
</header>
<main class="wrap">
